# ===========================================================================
# African Talents API — configuration. Copiez ce fichier en `.env` (jamais commité).
# ===========================================================================

# --- Docker Compose : en développement, on ajoute la surcharge dev -----------
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
COMPOSE_PATH_SEPARATOR=:
# Port exposé sur votre machine pour l'API (changez-le si 8000 est déjà utilisé localement)
BACKEND_PORT=8009

# --- Django -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=True
# En production : clé aléatoire d'au moins 50 caractères
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=dev-insecure-change-me-please-generate-a-long-random-string-0123456789
ALLOWED_HOSTS=localhost,127.0.0.1
# Origines des frontends autorisées (site public = 5173, admin = 5174 par défaut avec Vite)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174
# Nombre de reverse-proxies de confiance devant l'API (0 = aucun ; utile pour l'IP client dans le journal d'audit)
NUM_PROXIES=0

# --- Base de données (les conteneurs utilisent POSTGRES_*, DATABASE_URL sert hors Docker) ---
POSTGRES_DB=african_talents
POSTGRES_USER=african_talents
POSTGRES_PASSWORD=change-me-in-dev
AFRICAN_TALENTS_DB_PORT=5433
DATABASE_URL=postgres://african_talents:change-me-in-dev@localhost:5433/african_talents
REDIS_URL=redis://localhost:6379/0

# --- Authentification ---------------------------------------------------------
JWT_ACCESS_LIFETIME=15m
JWT_REFRESH_LIFETIME=7d
# Le refresh token est stocké dans un cookie HttpOnly. En production (HTTPS) : Secure=True, SameSite=Lax
# (admin et API doivent partager le même domaine parent, ex. admin.exemple.com / api.exemple.com).
AUTH_REFRESH_COOKIE_SECURE=False
AUTH_REFRESH_COOKIE_SAMESITE=Lax
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Interfaces techniques (désactivées par défaut si DEBUG=False) -------------
DJANGO_ADMIN_ENABLED=True
API_DOCS_ENABLED=True

# --- Développement : génération auto des migrations au démarrage ---------------
# Mettre à 0 une fois les fichiers de migration commités ; toujours 0 en production.
AUTO_MAKEMIGRATIONS=1

# --- HR-Skills Pay (NE JAMAIS committer de vraies valeurs — utilisez un .env local uniquement) ---
# Sans ces 3 valeurs, les tests passent quand même (le gateway est simulé dans les tests),
# mais tout appel RÉEL à HR-Skills Pay (création de commande de vote en vrai, par exemple)
# échouera proprement avec un message clair tant qu'elles ne sont pas renseignées.
HRSKILLS_ENVIRONMENT=test
HRSKILLS_PUBLIC_KEY=
HRSKILLS_SECRET_KEY=
HRSKILLS_WEBHOOK_SECRET=
# Préfixe /sandbox en environnement de test : activé par défaut (contradiction entre SDK
# officiels relevée dans le rapport, §12) — passez à False si vos clés de test le refusent.
HRSKILLS_USE_SANDBOX_PREFIX=True
# Doit valoir true en plus de HRSKILLS_ENVIRONMENT=live pour autoriser de vrais paiements
# (garde-fou volontaire contre un basculement accidentel en production).
HRSKILLS_ALLOW_LIVE=False
# Délai avant qu'une commande dont le paiement reste "en attente" soit considérée expirée
# (filet de sécurité si le webhook n'arrive jamais).
HRSKILLS_PENDING_TIMEOUT_MINUTES=15
# Pour recevoir les webhooks en développement local, utilisez un tunnel (ngrok, cloudflared...)
# et configurez son URL publique dans le tableau de bord HR-Skills Pay.
# BACKEND_PUBLIC_URL=https://votre-tunnel.exemple.com
